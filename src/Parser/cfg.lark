# Caramel CFG
# Tokens - Reserved Words
%import common.WS_INLINE
%ignore WS_INLINE
%ignore /~\.(.|\n)*?\.~/

NEWLINE: /(\r?\n)+/

BACKROOM: "backroom"
BATTER.10: "batter@"
BEAN: "bean"
BLEND: "blend"
BREWED: "brewed"
CAFE: "cafe"
CREMA: "crema"
CHURRO: "churro"
COLD: "cold"
CUP: "cup"
DECAF: "decaf"
DEFOAM: "defoam"
DRIP: "drip"
ELIFROTH: "elifroth"
ELSPRESS: "elspress"
EMPTY: "empty"
FLAVOUR: "flavour"
GLAZE: "glaze"
HOT: "hot"
IFBREW: "ifbrew"
MUG: "mug"
NEW: "new"
ORDER: "order"
POUR: "pour"
RECIPE: "recipe"
REFILL: "refill?"
SKIP: "skip"
SNAP: "snap"
SYRUP: "syrup"
TASTE: "taste"
TILL: "till"
TEMP: "temp"
WHILEHOT: "whilehot"

# Tokens - Reserved Symbols
EQUALS: "="
PLUS: "+"
INCREMENT: "++"
EQUAL_PLUS: "+="
MINUS: "-"
DECREMENT: "--"
EQUAL_MINUS: "-="
MULTIPLY: "*"
FLEX_ASTERISK: "***"
EQUAL_ASTERISK: "*="
DIVIDE: "/"
EQUAL_DIVIDE: "/="
MODULO: "%"
GREATER_THAN: ">"
GREATER_EQUAL: ">="
LESSER_THAN: "<"
LESSER_EQUAL: "<="
NOT: "!"
NOT_EQUAL: "!="
EQ_EQUALS: "=="
AND: "&&"
OR: "||"
OP_PAREN: "("
CL_PAREN: ")"
OP_BRACKETS: "["
CL_BRACKETS: "]"
OP_BRACES: "{"
CL_BRACES:"}"
DOT_ACC: "."
COMMA: ","
COLON: ":"
SEMICOLON: ";"
ZERO: "0"
_empty: 

# LITERALS
BEANLIT: /[0-9]+/
DRIPLIT: /[0-9]+\.[0-9]+/
CHURROLIT: /'(\\.|[^\\'])'/
BLENDLIT: /"(\\.|[^\\"])*"/

# TEMPLIT.2: HOT | COLD

ID: /(?!(backroom|batter@|bean|blend|brewed|cafe|crema|churro|cold|cup|decaf|drip|elifroth|elspress|empty|glaze|hot|ifbrew|mug|new|order|pour|recipe|refill\?|skip|snap|syrup|taste|till|temp|whilehot)(?![a-zA-Z0-9_]))[a-z][a-zA-Z0-9_]{0,14}/

# CFG - RULES START
start: program

program: global_def main_def
global_def: global_dec global_def | _empty

global_dec: dec | crema_def | recipe_def | empty_def

dec: var_dec | var_assign | mug_dec | mug_call_assign | mug_glob_assign | glob_var_acc | glob_var_acc_val | arr_dec | crema_assign | object_def | crema_call | recipe_call | empty_call | unary_expressions

acc_mod: CAFE | BACKROOM | _empty
data_type: BEAN | DRIP | BLEND | CHURRO | TEMP 

var_dec: acc_mod var_list
var_list: BREWED data_type var_dec_const_init var_dec_const_tail | data_type var_dec_init var_dec_tail

var_dec_const_init: ID EQUALS value
var_dec_const_tail: COMMA ID EQUALS value var_dec_const_tail | _empty

var_dec_init: ID opt_assign
opt_assign: EQUALS value | _empty
var_dec_tail: COMMA var_dec_init var_dec_tail | _empty

var_assign: ID EQUALS value | ID EQUALS OP_PAREN value CL_PAREN | arr_call EQUALS arr_elem

value: ID | MINUS ID | literals | call | expressions
literals: BEANLIT | DRIPLIT | MINUS BEANLIT | MINUS DRIPLIT | BLENDLIT | HOT | COLD | CHURROLIT
call: mug_call | mug_glob_call | arr_call | recipe_call | empty_call | crema_call | glob_var_acc

mug_call: ID DOT_ACC ID
mug_glob_call: ORDER DOT_ACC ID DOT_ACC ID
arr_call: ID OP_BRACKETS array_index CL_BRACKETS arr_call_tail
arr_call_tail: OP_BRACKETS array_index CL_BRACKETS | _empty
array_index: BEANLIT
recipe_call: ID OP_PAREN recipe_args recipe_args_tail CL_PAREN
recipe_args: ID | literals | mug_call | mug_glob_call | arr_call | glob_var_acc

recipe_args_tail: COMMA recipe_args recipe_args_tail | _empty

empty_call: ID OP_PAREN CL_PAREN

crema_call: ID DOT_ACC crema_member
crema_member: ID | arr_call | recipe_call | empty_call

expressions: arith_expressions | logic_expressions | rel_expressions | unary_expressions
arith_expressions: arith_expressions arithm_op term | term
term: OP_PAREN arith_expressions CL_PAREN | num_operand
num_operand: BEANLIT | DRIPLIT | MINUS BEANLIT | MINUS DRIPLIT | CHURROLIT | HOT | COLD | ID | call | unary_expressions
arithm_op: PLUS | MINUS | MULTIPLY | DIVIDE | MODULO

unary_expressions: unary_op ID | ID unary_op 
unary_op: INCREMENT | DECREMENT

logic_expressions: logic_factor logic_expr_tail
logic_expr_tail: logic_op logic_factor logic_expr_tail | _empty
logic_factor: NOT logic_factor | logic_atom
logic_atom: rel_expressions | OP_PAREN logic_expressions CL_PAREN
logic_op: AND | OR

rel_expressions: rel_factor rel_expr_tail
rel_expr_tail: rel_op rel_factor rel_expr_tail | _empty
rel_factor: arith_expressions | num_operand | OP_PAREN logic_expressions CL_PAREN
rel_op: GREATER_THAN | LESSER_THAN | EQ_EQUALS | NOT_EQUAL | GREATER_EQUAL | LESSER_EQUAL

mug_dec: MUG ID OP_BRACKETS (var_dec)* CL_BRACKETS

mug_call_assign: mug_call EQUALS value
mug_glob_assign: mug_glob_call EQUALS value

glob_var_acc: ORDER DOT_ACC ID
glob_var_acc_val: glob_var_acc EQUALS value

arr_dec: acc_mod data_type ID arr_size EQUALS OP_BRACKETS arr_cont CL_BRACKETS
arr_size: OP_BRACKETS arr_size_val CL_BRACKETS arr_size_2d
arr_size_val: BEANLIT | FLEX_ASTERISK
arr_size_2d: OP_BRACKETS arr_size_val CL_BRACKETS | _empty
arr_elem: literals | expressions | ID | _empty
ext_arr_elem: COMMA arr_elem ext_arr_elem | _empty
arr_cont: OP_BRACKETS arr_elem ext_arr_elem CL_BRACKETS arr_cont_tail | arr_elem ext_arr_elem | _empty
arr_cont_tail: COMMA OP_BRACKETS arr_elem ext_arr_elem CL_BRACKETS | _empty

object_def: NEW ID EQUALS ID
crema_assign: crema_call EQUALS value

recipe_def: RECIPE data_type ID OP_PAREN parameter CL_PAREN OP_BRACKETS  recipe_body refill_final  CL_BRACKETS
parameter: param_val add_param | _empty
param_val: var_dec | mug_call | mug_glob_call 
add_param: COMMA param_val add_param | _empty
recipe_body: statement  recipe_body | dec  recipe_body | _empty 

refill_final: REFILL refill_arg
refill_arg: OP_PAREN refill_content extra_refill_val CL_PAREN | ZERO

refill_content: literals | expressions | mug_call | ID 
extra_refill_val: COMMA refill_content extra_refill_val | _empty

empty_def: EMPTY ID OP_PAREN parameter CL_PAREN OP_BRACKETS  statement  REFILL  CL_BRACKETS 

crema_def: CREMA ID OP_BRACKETS  crema_body CL_BRACKETS
crema_body: crema_body_cont  crema_body | _empty
crema_body_cont: acc_mod recipe_def | acc_mod empty_def | var_dec | arr_dec

main_def: BEAN CUP OP_PAREN CL_PAREN OP_BRACKETS main_body


refill_main: REFILL ZERO  main_body | REFILL ZERO CL_BRACKETS

main_body: statement main_body | refill_main


statement: dec | input_stmt | output_stmt | if_cond | flav_switch | pour_loop | whilehot_loop | tastetill_loop
stmt_tail: statement stmt_tail | _empty

input_stmt: BATTER input_args input_val 
input_args: input_args_unit input_args_unit_tail
input_args_unit: ID | crema_inp_call | mug_call | mug_glob_call | arr_call | glob_var_acc
crema_inp_call: ID DOT_ACC mug_call
input_args_unit_tail: COMMA input_args_unit input_args_unit_tail | _empty
input_val: OP_PAREN BLENDLIT CL_PAREN | _empty

output_stmt: GLAZE OP_PAREN output_args CL_PAREN
output_args: value concat | _empty
concat: PLUS value concat | _empty

if_cond: IFBREW OP_PAREN expressions CL_PAREN OP_BRACES statement stmt_tail CL_BRACES if_cond_tail

if_cond_tail:  ELIFROTH OP_PAREN expressions CL_PAREN OP_BRACES statement stmt_tail CL_BRACES if_cond_tail | ELSPRESS OP_BRACES statement stmt_tail CL_BRACES | _empty

flav_switch: FLAVOUR OP_PAREN expressions CL_PAREN OP_BRACES syrup_switch CL_BRACES 
syrup_switch: SYRUP case_lit COLON  statement stmt_tail SNAP  defoam_stmt syrup_switch | _empty
case_lit: BEANLIT | CHURROLIT | HOT | COLD 
defoam_stmt: DEFOAM COLON statement stmt_tail  SNAP  | _empty

pour_loop: POUR OP_PAREN pour_init SEMICOLON logic_expressions SEMICOLON update CL_PAREN OP_BRACES statement stmt_tail (intrpt_stmt)* CL_BRACES
pour_init: data_type ID EQUALS value var_dec_const_tail
update: update_unit update_tail
update_tail: COMMA update_unit update_tail | _empty
update_unit: ID assign_op arith_expressions | unary_expressions
assign_op: EQUALS | EQUAL_PLUS | EQUAL_MINUS | EQUAL_ASTERISK | EQUAL_DIVIDE 

whilehot_loop: WHILEHOT OP_PAREN logic_expressions CL_PAREN OP_BRACES statement stmt_tail intrpt_stmt CL_BRACES
tastetill_loop: TASTE OP_BRACES statement stmt_tail intrpt_stmt CL_BRACES TILL COLON OP_PAREN logic_expressions CL_PAREN
intrpt_stmt: SNAP | SKIP  | _empty