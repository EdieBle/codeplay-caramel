# ============================================================================
# CARAMEL CFG - REFACTORED (LL(1) Compatible)
# ============================================================================
# All predict set conflicts have been resolved via:
#   1. Left-factoring (ID, ORDER, data_type ambiguities)
#   2. Proper expression hierarchy (logic > relational > arithmetic > unary > primary)
#   3. Left-recursion elimination (arith_expressions)
#   4. Tail-based disambiguation (look at what follows the shared prefix)
# ============================================================================

# Tokens - Reserved Words
%import common.WS_INLINE
%ignore WS_INLINE
%ignore /~\.(.|\n)*?\.~/

NEWLINE: /(\r?\n)+/

BACKROOM: "backroom"
BATTER.10: "batter@"
BEAN: "bean"
BLEND: "blend"
BREWED: "brewed"
CAFE: "cafe"
CREMA: "crema"
CHURRO: "churro"
COLD: "cold"
CUP: "cup"
DECAF: "decaf"
DEFOAM: "defoam"
DRIP: "drip"
ELIFROTH: "elifroth"
ELSPRESS: "elspress"
EMPTY: "empty"
FLAVOUR: "flavour"
GLAZE: "glaze"
HOT: "hot"
IFBREW: "ifbrew"
MUG: "mug"
NEW: "new"
ORDER: "order"
POUR: "pour"
RECIPE: "recipe"
REFILL: "refill?"
SKIP: "skip"
SNAP: "snap"
SYRUP: "syrup"
TASTE: "taste"
TILL: "till"
TEMP: "temp"
WHILEHOT: "whilehot"

# Tokens - Reserved Symbols
EQUALS: "="
PLUS: "+"
INCREMENT: "++"
EQUAL_PLUS: "+="
MINUS: "-"
DECREMENT: "--"
EQUAL_MINUS: "-="
MULTIPLY: "*"
FLEX_ASTERISK: "***"
EQUAL_ASTERISK: "*="
DIVIDE: "/"
EQUAL_DIVIDE: "/="
MODULO: "%"
GREATER_THAN: ">"
GREATER_EQUAL: ">="
LESSER_THAN: "<"
LESSER_EQUAL: "<="
NOT: "!"
NOT_EQUAL: "!="
EQ_EQUALS: "=="
AND: "&&"
OR: "||"
OP_PAREN: "("
CL_PAREN: ")"
OP_BRACKETS: "["
CL_BRACKETS: "]"
OP_BRACES: "{"
CL_BRACES: "}"
DOT_ACC: "."
COMMA: ","
COLON: ":"
SEMICOLON: ";"
ZERO: "0"
_empty:

# LITERALS
BEANLIT: /-?[0-9]+/
DRIPLIT: /-?[0-9]+\.[0-9]+/
CHURROLIT: /'(\\.|[^\\'])'/
BLENDLIT: /"(\\.|[^\\"])*"/

ID: /(?!(backroom|batter@|bean|blend|brewed|cafe|crema|churro|cold|cup|decaf|drip|elifroth|elspress|empty|glaze|hot|ifbrew|mug|new|order|pour|recipe|refill\?|skip|snap|syrup|taste|till|temp|whilehot)(?![a-zA-Z0-9_]))[a-z][a-zA-Z0-9_]{0,14}/

# ============================================================================
# CFG RULES START
# ============================================================================

start: program

# --------------------------------------------------------------------------
# PROGRAM STRUCTURE
# --------------------------------------------------------------------------
# FIX: global_def vs main_def overlap on 'bean'
#   - global_def → λ has 'bean' in FOLLOW (from main_def)
#   - global_def → global_dec also has 'bean' (from var_dec)
# SOLUTION: global_dec cannot start with bare 'bean' data_type without
#   a distinguishing keyword. We separate global decs that start with
#   acc_mod (cafe/backroom) or brewed, vs data_type-led decs.
#   Actually, the real fix is that main_def always starts with "bean cup"
#   so we need 2-token lookahead OR restructure global_def to not use λ
#   with bean in FOLLOW. We handle this by making the parser check
#   "bean cup" as the main_def trigger.
# --------------------------------------------------------------------------
program: global_def main_def

global_def: global_dec global_def | _empty
# Predict: global_dec → {cafe, backroom, drip, blend, churro, temp, brewed, ID, order, ++, --, mug, new, recipe, empty, crema, bean}
# Predict: λ → FOLLOW(global_def) = {bean cup} — but 'bean' overlaps
# FIX: We use a special rule. 'bean' in global context MUST be followed
#   by a data_type usage pattern (ID or brewed), NOT by 'cup'.
#   Lark can handle this with priority, but for true LL(1) we restructure:

global_dec: acc_mod_dec | id_dec_stmt | order_dec_stmt | mug_dec | object_def | crema_def | recipe_def | empty_def

# --------------------------------------------------------------------------
# DECLARATIONS (dec) - LEFT FACTORED
# --------------------------------------------------------------------------
# ORIGINAL CONFLICT: 11 alternatives in <dec>, 6 start with ID, 3 with ORDER,
#   var_dec/arr_dec overlap on cafe/backroom/bean/drip/blend/churro/temp
#
# SOLUTION: Group by leading terminal:
#   - cafe/backroom → acc_mod_dec (could be var_dec or arr_dec)
#   - brewed → brewed_dec (const var declaration)
#   - bean/drip/blend/churro/temp → dtype_dec (var_dec or arr_dec)
#   - ID → id_dec_stmt (left-factor all ID-leading alternatives)
#   - ORDER → order_dec_stmt (left-factor all ORDER-leading alternatives)
#   - ++/-- → pre_unary_dec (prefix unary)
#   - mug → mug_dec
#   - new → object_def
# --------------------------------------------------------------------------
dec: acc_mod_dec | id_dec_stmt | order_dec_stmt | pre_unary_dec | mug_dec | object_def

# --- Access modifier declarations (cafe/backroom prefix) ---
# FIX: var_dec vs arr_dec overlap when both start with acc_mod + data_type
# SOLUTION: After acc_mod + data_type + ID, look at what follows:
#   - If '[' follows ID → arr_dec (array size declaration)
#   - Otherwise → var_dec
acc_mod_dec: CAFE acc_mod_dec_body | BACKROOM acc_mod_dec_body | dtype_dec

acc_mod_dec_body: BREWED acc_brewed_body                                         # ✓ FIXED: left-factored BREWED
    | BLEND ID blend_id_tail
    | data_type ID acc_dtype_tail

acc_brewed_body: data_type var_dec_const_init var_dec_const_tail
    | BLEND blend_const_init blend_const_init_tail

# After acc_mod + data_type + ID, disambiguate:
#   - OP_BRACKETS → array declaration (1D or 2D)
#   - EQUALS or COMMA or other → variable declaration
# FIX: arr_dec_dim enforces that 2D size requires 2D content, 1D size requires 1D content
acc_dtype_tail: OP_BRACKETS arr_size_val CL_BRACKETS arr_dec_dim
    | opt_assign var_dec_tail

# --- Data-type-led declarations (no access modifier) ---
# FIX: Merges var_dec (without acc_mod) and arr_dec (without acc_mod)
dtype_dec: BREWED dtype_brewed_body                                              # ✓ FIXED: left-factored BREWED
    | BLEND ID blend_id_tail
    | data_type ID dtype_id_tail

dtype_brewed_body: data_type var_dec_const_init var_dec_const_tail
    | BLEND blend_const_init blend_const_init_tail

# Same disambiguation after data_type + ID:
# FIX: arr_dec_dim enforces 1D/2D content must match declared dimensions
dtype_id_tail: OP_BRACKETS arr_size_val CL_BRACKETS arr_dec_dim
    | opt_assign var_dec_tail

# --------------------------------------------------------------------------
# BLEND DECLARATION (Left-factored)
# --------------------------------------------------------------------------
blend_const_init: ID EQUALS blend_val 
blend_const_init_tail: COMMA ID EQUALS blend_val blend_const_init_tail | _empty
blend_id_tail: blend_assign blend_tail | OP_BRACKETS arr_size_val CL_BRACKETS blend_arr_dec_dim

blend_assign: EQUALS blend_val | _empty
blend_tail: COMMA ID blend_assign blend_tail | _empty
blend_val: blend_term blend_val_tail
blend_val_tail: PLUS blend_term blend_val_tail | _empty
blend_term: BLENDLIT | ID blend_term_id_tail | ORDER DOT_ACC ID | OP_PAREN blend_val CL_PAREN

# After ID in blend_term context:
#   '.' → mug_call: ID.ID (e.g. blend b = x.y)
#   else → bare ID variable reference
blend_term_id_tail: DOT_ACC ID | _empty

blend_arr_elem: BLENDLIT |  _empty
blend_ext_arr_elem: COMMA blend_arr_elem blend_ext_arr_elem | _empty
blend_arr_cont_1d: blend_arr_elem blend_ext_arr_elem | _empty
blend_arr_cont_2d: OP_BRACKETS blend_arr_elem blend_ext_arr_elem CL_BRACKETS blend_arr_cont_2d_tail | _empty
blend_arr_cont_2d_tail: COMMA OP_BRACKETS blend_arr_elem blend_ext_arr_elem CL_BRACKETS blend_arr_cont_2d_tail | _empty


# --------------------------------------------------------------------------
# ID-LED STATEMENTS (Left-factored)
# --------------------------------------------------------------------------
# ORIGINAL CONFLICT: When parser sees ID, it could be any of:
#   var_assign (ID = value), mug_call_assign (ID.ID = value),
#   crema_assign (ID.crema_member = value), crema_call (ID.crema_member),
#   function_call (ID(...)), unary postfix (ID++/ID--)
#
# SOLUTION: Consume ID, then look at the NEXT token to decide:
#   '='      → simple variable assignment
#   '.'      → dot access (mug_call, crema_call, crema_assign)
#   '('      → function call
#   '['      → array call assignment (arr_call = arr_elem)
#   '++/--'  → postfix unary expression
# --------------------------------------------------------------------------
id_dec_stmt: ID id_dec_tail

id_dec_tail: EQUALS assign_val                                                       # var_assign: ID = value
    | DOT_ACC ID id_dot_tail                                                    # mug/crema access
    | OP_PAREN function_args function_args_tail CL_PAREN                        # function_call: ID(args)
    | OP_BRACKETS array_index CL_BRACKETS id_bracket_tail                       # arr_call then assign
    | unary_op                                                                  # postfix unary: ID++, ID--

# FIX: assign_val had FIRST-FIRST conflict on {ID, OP_PAREN} between value and blend_val
#   value → expression → primary → ID | ( expression )
#   blend_val → blend_term → ID | ( blend_val )
# SOLUTION: BLENDLIT is the ONLY token unique to blend_val (not in expression's FIRST set).
#   Split: BLENDLIT-led RHS uses concat (string concatenation), everything else uses expression.
#   FIRST(BLENDLIT concat) = {BLENDLIT}, FIRST(expression) = {!,++,--,-,ID,order,...,(}
#   Overlap = ∅ → ambiguity resolved.
assign_val: BLENDLIT concat | expression

# After ID.ID, what follows?
#   '='          → mug_call_assign: ID.ID = value
#   '.' | '(' | '[' → crema member access chain, possibly with assignment
#   otherwise    → standalone mug_call or crema_call (field access)
id_dot_tail: EQUALS assign_val                                                   # mug_call_assign ✓ FIXED
    | DOT_ACC crema_member_inner id_crema_assign_tail                           # crema_call / crema_assign: ID.ID.member...
    | OP_BRACKETS array_index CL_BRACKETS arr_call_tail id_crema_assign_tail    # ID.arr_call[i] possibly = value
    | OP_PAREN function_args function_args_tail CL_PAREN                        # ID.func_call()
    | _empty                                                                    # standalone mug_call (ID.ID)

# After crema member access, optionally assign
id_crema_assign_tail: EQUALS assign_val | _empty                                 # ✓ FIXED

# After ID[index]..., check for assignment
id_bracket_tail: OP_BRACKETS array_index CL_BRACKETS EQUALS arr_elem           # 2D arr_call = arr_elem
    | EQUALS arr_elem                                                           # 1D arr_call = arr_elem

# Crema member (after the second dot): ID or arr_call or function_call
# FIX: crema_member had ID vs arr_call vs function_call overlap on ID
# SOLUTION: Left-factor with ID then look at next token
crema_member_inner: ID crema_member_inner_tail

crema_member_inner_tail: OP_BRACKETS array_index CL_BRACKETS arr_call_tail      # arr_call
    | OP_PAREN function_args function_args_tail CL_PAREN                        # function_call
    | _empty                                                                    # plain ID

# --------------------------------------------------------------------------
# ORDER-LED STATEMENTS (Left-factored)
# --------------------------------------------------------------------------
# ORIGINAL CONFLICT: ORDER starts glob_var_acc, glob_var_acc_val, mug_glob_assign
# SOLUTION: Consume ORDER.ID, then look at next token:
#   '='          → glob_var_acc_val
#   '.ID'        → mug_glob access, then check for '=' (assign) or not
#   otherwise    → standalone glob_var_acc
# --------------------------------------------------------------------------
order_dec_stmt: ORDER DOT_ACC ID order_dec_tail

order_dec_tail: EQUALS assign_val                                                # glob_var_acc_val ✓ FIXED
    | DOT_ACC ID order_mug_tail                                                 # mug_glob_call/assign: order.ID.ID ...
    | _empty                                                                    # standalone glob_var_acc: order.ID

order_mug_tail: EQUALS assign_val                                                # mug_glob_assign ✓ FIXED
    | _empty                                                                    # standalone mug_glob_call: order.ID.ID

# --------------------------------------------------------------------------
# PREFIX UNARY (++ID, --ID)
# --------------------------------------------------------------------------
pre_unary_dec: unary_op ID

# --------------------------------------------------------------------------
# DATA TYPES & ACCESS MODIFIERS
# --------------------------------------------------------------------------
data_type: BEAN | DRIP | CHURRO | TEMP      # Removed blend data type to differentiate the blend_dec

# --------------------------------------------------------------------------
# VARIABLE DECLARATIONS (sub-rules, conflict-free)
# --------------------------------------------------------------------------
var_dec_const_init: ID EQUALS value


var_dec_const_tail: COMMA ID EQUALS value var_dec_const_tail | _empty

var_dec_init: ID opt_assign
opt_assign: EQUALS value | _empty
var_dec_tail: COMMA var_dec_init var_dec_tail | _empty

# --------------------------------------------------------------------------
# VALUES - RESTRUCTURED
# --------------------------------------------------------------------------
# ORIGINAL CONFLICT: value had 5 alternatives all overlapping on ID, (, -, literals
# SOLUTION: value IS an expression. Simple values (ID, literals, calls) are
#   the 'primary' level of the expression hierarchy. The parser always
#   parses a full expression and the tree structure shows if it's simple or compound.
# --------------------------------------------------------------------------
value: expression

# ============================================================================
# EXPRESSION HIERARCHY (Operator Precedence, LL(1) compatible)
# ============================================================================
# Precedence (low to high):
#   1. logic_expr      (&&, ||)
#   2. rel_expr        (<, >, ==, !=, <=, >=)
#   3. arith_expr      (+, -, *, /, %)
#   4. unary_expr      (prefix ++/--, prefix -ID, prefix -(expr))
#   5. primary         (ID, literals, calls, parenthesized)
#
# This ELIMINATES:
#   - expressions overlap (rules 82-85) — no more choosing between arith/rel/logic
#   - logic_atom overlap (rules 116-119) — folded into hierarchy
#   - rel_factor overlap (rules 127-129) — folded into hierarchy
#   - arith_expressions left recursion (rule 88) — replaced with tail recursion
#   - arith_expr_tail_cont overlap (rules 91-92) — merged
#   - num_operand overlap (rules 93-101) — replaced by primary
# ============================================================================

expression: not_factor logic_expr_tail

# --- Logic level ---
logic_expr_tail: logic_op not_factor logic_expr_tail | _empty
logic_op: AND | OR

not_factor: NOT rel_expr | rel_expr

# --- Relational level ---
rel_expr: arith_expr rel_expr_tail
rel_expr_tail: rel_op arith_expr rel_expr_tail | _empty
rel_op: GREATER_THAN | LESSER_THAN | EQ_EQUALS | NOT_EQUAL | GREATER_EQUAL | LESSER_EQUAL

# --- Arithmetic level (LEFT RECURSION ELIMINATED) ---
arith_expr: unary_expr arith_expr_tail
arith_expr_tail: arithm_op unary_expr arith_expr_tail | _empty
arithm_op: PLUS | MINUS | MULTIPLY | DIVIDE | MODULO

# --- Unary level ---
# FIX: unary_expressions had ID overlap (prefix vs postfix)
# SOLUTION: prefix unary consumes op then primary; postfix is handled
#   inside primary_tail after ID
# UPDATED: MINUS now supports both -ID and -(expression) via neg_operand
unary_expr: INCREMENT primary | DECREMENT primary | MINUS neg_operand | primary

# After MINUS, determine the negated target:
#   ID        → variable negation: -myVar
#   '(' expr ')' → parenthesized expression negation: -(3 + 2)
neg_operand: ID | OP_PAREN expression CL_PAREN

# --- Primary level (atoms) ---
# FIX: All ID-starting things (bare ID, mug_call, arr_call, function_call,
#   crema_call, postfix unary) are left-factored into ID + primary_id_tail
primary: ID primary_id_tail
    | ORDER DOT_ACC ID primary_order_tail
    | BEANLIT | DRIPLIT | CHURROLIT | HOT | COLD
    | OP_PAREN expression CL_PAREN
# NOTE: Negative beanlit/driplit are handled by the literal tokens themselves.
# Unary MINUS applies to ID (-myVar) or parenthesized expressions (-(3+2)).

# After ID in an expression, determine what it is:
#   '.'      → mug_call (ID.ID) or crema_call (ID.member)
#   '('      → function_call
#   '['      → array access
#   '++'/'--' → postfix unary
#   otherwise → bare ID (variable reference)
primary_id_tail: DOT_ACC ID primary_dot_tail
    | OP_PAREN function_args function_args_tail CL_PAREN
    | OP_BRACKETS array_index CL_BRACKETS arr_call_tail
    | INCREMENT | DECREMENT
    | _empty

# After ID.ID in expression:
#   could still be crema chain (ID.ID.something) or just mug_call
primary_dot_tail: DOT_ACC crema_member_inner
    | OP_BRACKETS array_index CL_BRACKETS arr_call_tail
    | OP_PAREN function_args function_args_tail CL_PAREN
    | _empty

# After order.ID in expression:
#   '.'  → mug_glob_call: order.ID.ID
#   else → glob_var_acc: order.ID
primary_order_tail: DOT_ACC ID | _empty

# --------------------------------------------------------------------------
# ARRAY RULES
# --------------------------------------------------------------------------
# FIX: Original arr_size + arr_cont allowed 2D-declared arrays with 1D content.
#   e.g. bean room[3][3] = [5,3,2] was accepted (should be INVALID).
# SOLUTION: After the first [N], look at what follows to determine dimensionality:
#   [M] → 2D declaration → content MUST be nested brackets: [[...], [...]]
#   =   → 1D declaration → content MUST be flat elements: [1, 2, 3]
# This enforces that declared dimensions match the content structure.
# --------------------------------------------------------------------------
arr_call_tail: OP_BRACKETS array_index CL_BRACKETS | _empty
array_index: BEANLIT

arr_size_val: BEANLIT | FLEX_ASTERISK

# After data_type ID [N], determine 1D vs 2D:
#   [M] = [[...]] → 2D array (nested bracket content required)
#   = [...]       → 1D array (flat element content required)
arr_dec_dim: OP_BRACKETS arr_size_val CL_BRACKETS EQUALS OP_BRACKETS arr_cont_2d CL_BRACKETS
    | EQUALS OP_BRACKETS arr_cont_1d CL_BRACKETS

# After blend ID [N], determine 1D vs 2D for blend arrays:
blend_arr_dec_dim: OP_BRACKETS arr_size_val CL_BRACKETS EQUALS OP_BRACKETS blend_arr_cont_2d CL_BRACKETS
    | EQUALS OP_BRACKETS blend_arr_cont_1d CL_BRACKETS

# FIX: arr_elem had literals vs expressions vs ID overlap
# SOLUTION: arr_elem is just an optional expression (value)
arr_elem: expression |  _empty

ext_arr_elem: COMMA arr_elem ext_arr_elem | _empty

# 1D array content: flat elements only (e.g. [1, 2, 3])
arr_cont_1d: arr_elem ext_arr_elem | _empty

# 2D array content: nested bracket rows only (e.g. [[1,2], [3,4]])
arr_cont_2d: OP_BRACKETS arr_elem ext_arr_elem CL_BRACKETS arr_cont_2d_tail | _empty
arr_cont_2d_tail: COMMA OP_BRACKETS arr_elem ext_arr_elem CL_BRACKETS arr_cont_2d_tail | _empty

# --------------------------------------------------------------------------
# FUNCTION CALLS & ARGUMENTS
# --------------------------------------------------------------------------
# FIX: function_args had ID vs mug_call vs arr_call vs mug_glob_call overlap
# SOLUTION: function_arg is just a value (expression), which already handles
#   all these through the primary level
# --------------------------------------------------------------------------
function_call: ID OP_PAREN function_args function_args_tail CL_PAREN
function_args: expression | BLENDLIT | _empty
function_args_tail: COMMA function_args function_args_tail | _empty

# --------------------------------------------------------------------------
# UNARY OPERATOR
# --------------------------------------------------------------------------
unary_op: INCREMENT | DECREMENT

# --------------------------------------------------------------------------
# MUG (Struct) DECLARATIONS
# --------------------------------------------------------------------------
mug_dec: MUG ID OP_BRACKETS dtype_mug_var mug_var_dec_cont CL_BRACKETS            # ✓ FIXED: pure CFG (removed EBNF *)
dtype_mug_var: BREWED mug_brewed_body                                            # ✓ FIXED: left-factored BREWED
    | data_type var_dec_init var_dec_tail
    | BLEND ID blend_id_tail

mug_brewed_body: data_type var_dec_const_init var_dec_const_tail
    | BLEND blend_const_init blend_const_init_tail
mug_var_dec_cont: dtype_mug_var mug_var_dec_cont | _empty                         # ✓ recursive for multiple members

# --------------------------------------------------------------------------
# OBJECT DEFINITION
# --------------------------------------------------------------------------
object_def: NEW ID EQUALS ID

# --------------------------------------------------------------------------
# RECIPE (Function) DEFINITION
# --------------------------------------------------------------------------
# FIX: recipe_body had statement vs dec overlap (dec is subset of statement)
# SOLUTION: recipe_body only uses statement (which already includes dec)
# --------------------------------------------------------------------------
recipe_def: RECIPE recipe_ret_type ID OP_PAREN parameter CL_PAREN OP_BRACKETS recipe_body refill_final CL_BRACKETS  # ✓ FIXED: left-factored RECIPE

recipe_ret_type: data_type | BLEND
parameter: dtype_param  add_param | _empty

# FIX: param_val had var_dec vs mug_call vs mug_glob_call overlap
# SOLUTION: Left-factor. Parameters starting with ID need disambiguation.

dtype_param: BREWED param_brewed_body                                            # ✓ FIXED: left-factored BREWED
    | data_type var_dec_init var_dec_tail
    | BLEND ID blend_assign blend_tail

param_brewed_body: data_type var_dec_const_init var_dec_const_tail
    | BLEND blend_const_init blend_const_init_tail

param_dtype_body: BREWED data_type var_dec_const_init var_dec_const_tail
    | data_type var_dec_init var_dec_tail

# After ID in parameter context:
#   '.' → mug_call parameter (ID.ID)
#   otherwise → it's a var_dec_init (ID with opt_assign) — but ID alone in
#   param context doesn't make sense without data_type prefix, so this is mug_call
param_id_tail: DOT_ACC ID

add_param: COMMA dtype_param add_param | _empty

recipe_body: statement recipe_body | _empty

refill_final: REFILL refill_arg
refill_arg: OP_PAREN refill_content extra_refill_val CL_PAREN | ZERO

# FIX: refill_content had literals vs expressions vs mug_call vs ID overlap
# SOLUTION: refill_content is just an expression
refill_content: expression | BLENDLIT   #added blendlit
extra_refill_val: COMMA refill_content extra_refill_val | _empty

# --------------------------------------------------------------------------
# EMPTY (Void Function) DEFINITION
# --------------------------------------------------------------------------
empty_def: EMPTY ID OP_PAREN parameter CL_PAREN OP_BRACKETS empty_body REFILL CL_BRACKETS

empty_body: statement empty_body | _empty

# --------------------------------------------------------------------------
# CREMA (Class) DEFINITION
# --------------------------------------------------------------------------
crema_def: CREMA ID OP_BRACKETS crema_body CL_BRACKETS
crema_body: crema_body_cont crema_body | _empty

# FIX: crema_body_cont had acc_mod overlapping between recipe_def/empty_def and var_dec/arr_dec
# SOLUTION: separate by leading keyword
crema_body_cont: CAFE crema_acc_body | BACKROOM crema_acc_body | crema_dtype_body

crema_acc_body: RECIPE data_type ID OP_PAREN parameter CL_PAREN OP_BRACKETS recipe_body refill_final CL_BRACKETS
    | EMPTY ID OP_PAREN parameter CL_PAREN OP_BRACKETS empty_body REFILL CL_BRACKETS
    | BREWED crema_acc_brewed_body                                               # ✓ FIXED: left-factored BREWED
    | data_type ID crema_dtype_id_tail
    | BLEND ID blend_id_tail

crema_acc_brewed_body: data_type var_dec_const_init var_dec_const_tail
    | BLEND blend_const_init blend_const_init_tail

crema_dtype_body: RECIPE crema_recipe_type ID OP_PAREN parameter CL_PAREN OP_BRACKETS recipe_body refill_final CL_BRACKETS  # ✓ FIXED: left-factored RECIPE
    | EMPTY ID OP_PAREN parameter CL_PAREN OP_BRACKETS empty_body REFILL CL_BRACKETS
    | BREWED crema_dtype_brewed_body                                             # ✓ FIXED: left-factored BREWED
    | data_type ID crema_dtype_id_tail
    | BLEND ID blend_id_tail

crema_recipe_type: data_type | BLEND

crema_dtype_brewed_body: data_type var_dec_const_init var_dec_const_tail
    | BLEND blend_const_init blend_const_init_tail

# In crema body, after data_type + ID, disambiguate var vs array:
# FIX: arr_dec_dim enforces 1D/2D content must match declared dimensions
crema_dtype_id_tail: OP_BRACKETS arr_size_val CL_BRACKETS arr_dec_dim
    | opt_assign var_dec_tail

# --------------------------------------------------------------------------
# MAIN DEFINITION
# --------------------------------------------------------------------------
main_def: BEAN CUP OP_PAREN CL_PAREN OP_BRACKETS main_body

refill_main: REFILL ZERO refill_main_tail                                       # ✓ FIXED: left-factored REFILL ZERO
refill_main_tail: main_body | CL_BRACKETS
main_body: statement main_body | refill_main

# --------------------------------------------------------------------------
# STATEMENTS
# --------------------------------------------------------------------------
statement: dec | input_stmt | output_stmt | if_cond | flav_switch | pour_loop | whilehot_loop | tastetill_loop | intrpt_stmt
stmt_tail: statement stmt_tail | _empty

# --------------------------------------------------------------------------
# INPUT STATEMENT
# --------------------------------------------------------------------------
# FIX: input_args_unit had ID vs crema_inp_call vs mug_call vs arr_call overlap
# SOLUTION: Left-factor with ID + input_id_tail
# --------------------------------------------------------------------------
input_stmt: BATTER input_args input_val
input_args: input_args_unit input_args_unit_tail

input_args_unit: ID input_id_tail | ORDER DOT_ACC ID input_order_tail

# After ID in input context:
#   '.'  → mug_call (ID.ID) or crema_inp_call (ID.ID.ID)
#   '['  → arr_call
#   else → bare ID
input_id_tail: DOT_ACC ID input_dot_tail
    | OP_BRACKETS array_index CL_BRACKETS arr_call_tail
    | _empty

# After ID.ID in input:
#   '.'  → crema_inp_call: ID.ID.ID (accessing crema's mug member)
#   else → mug_call: ID.ID
input_dot_tail: DOT_ACC ID | _empty

# After order.ID in input:
#   '.'  → could be mug_glob_call or further access
#   else → glob_var_acc
input_order_tail: DOT_ACC ID | _empty

input_args_unit_tail: COMMA input_args_unit input_args_unit_tail | _empty
input_val: OP_PAREN BLENDLIT CL_PAREN | _empty

# --------------------------------------------------------------------------
# OUTPUT STATEMENT
# --------------------------------------------------------------------------
output_stmt: GLAZE OP_PAREN output_args CL_PAREN
output_args: expression concat | BLENDLIT concat | _empty
concat: PLUS blend_term concat | _empty

# --------------------------------------------------------------------------
# CONDITIONAL (if/elif/else)
# --------------------------------------------------------------------------
if_cond: IFBREW OP_PAREN expression CL_PAREN OP_BRACES statement stmt_tail CL_BRACES if_cond_tail
if_cond_tail: ELIFROTH OP_PAREN expression CL_PAREN OP_BRACES statement stmt_tail CL_BRACES if_cond_tail
    | ELSPRESS OP_BRACES statement stmt_tail CL_BRACES
    | _empty

# --------------------------------------------------------------------------
# SWITCH (flavour/syrup)
# --------------------------------------------------------------------------
# FIX: flav_switch had expressions vs ID overlap inside the parentheses
# SOLUTION: Use expression (which already handles bare ID as primary)
# --------------------------------------------------------------------------
flav_switch: FLAVOUR OP_PAREN flav_lit CL_PAREN OP_BRACES syrup_switch CL_BRACES
flav_lit: BEANLIT | ID | CHURROLIT | HOT | COLD
syrup_switch: SYRUP case_lit COLON statement stmt_tail SNAP defoam_stmt syrup_switch_tail
syrup_switch_tail: syrup_switch | _empty
case_lit: BEANLIT | CHURROLIT | HOT | COLD
defoam_stmt: DEFOAM COLON statement stmt_tail SNAP | _empty

# --------------------------------------------------------------------------
# FOR LOOP (pour)
# --------------------------------------------------------------------------
# FIX: pour_loop had logic_expressions vs rel_expressions overlap in condition
# SOLUTION: Use unified expression (hierarchy handles precedence)
# --------------------------------------------------------------------------
pour_loop: POUR OP_PAREN pour_init SEMICOLON expression SEMICOLON update CL_PAREN OP_BRACES statement stmt_tail CL_BRACES
pour_init: data_type ID EQUALS value var_dec_const_tail

# FIX: update_unit had ID overlap between ID assign_op and unary_expressions
# SOLUTION: Left-factor on ID
update: update_unit update_tail
update_tail: COMMA update_unit update_tail | _empty
update_unit: ID update_id_tail | INCREMENT ID | DECREMENT ID

# After ID in update context:
#   assign_op → ID = value, ID += value, etc.
#   ++ / --   → postfix unary: ID++, ID--
update_id_tail: assign_op update_val | INCREMENT | DECREMENT

assign_op: EQUALS | EQUAL_PLUS | EQUAL_MINUS | EQUAL_ASTERISK | EQUAL_DIVIDE
update_val: expression

# --------------------------------------------------------------------------
# WHILE LOOP (whilehot)
# --------------------------------------------------------------------------
# FIX: logic_expressions vs rel_expressions overlap
# SOLUTION: Use unified expression
# --------------------------------------------------------------------------
whilehot_loop: WHILEHOT OP_PAREN expression CL_PAREN OP_BRACES statement stmt_tail  CL_BRACES

# --------------------------------------------------------------------------
# DO-WHILE LOOP (taste...till)
# --------------------------------------------------------------------------
# FIX: Same logic vs rel overlap
# SOLUTION: Use unified expression
# --------------------------------------------------------------------------
tastetill_loop: TASTE OP_BRACES statement stmt_tail CL_BRACES TILL COLON OP_PAREN expression CL_PAREN

# --------------------------------------------------------------------------
# INTERRUPT STATEMENTS
# --------------------------------------------------------------------------
intrpt_stmt: SNAP | SKIP 