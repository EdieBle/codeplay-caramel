bean cup() [
    blend word 
	churro choice, temp1
    churro chars[5]
	bean i, j

    batter@word("Enter a word: ")
    batter@choice("Ascending (A) or Descending (D)? ")

    
    ~~ Convert string to array (assuming word indexing works, PRAY)

	bean word_len = sift(word)
    pour(bean i = 0; i < word_len; i++) {
        chars[i] = word[i]
    }

    
    ~~ Bubble sort
    pour(bean i = 0; i < word_len; i++) {
        pour(bean j = 0; j < word_len - i - 1; j++) {
            ifbrew (choice == "A") {
                ifbrew (chars[j] > chars[j + 1]) {
                    temp1 = chars[j]
                    chars[j] = chars[j + 1]
                    chars[j + 1] = temp1
                }
            } elspress {
                ifbrew (chars[j] < chars[j + 1]) {
                    temp1 = chars[j]
                    chars[j] = chars[j + 1]
                    chars[j + 1] = temp1
                }
            }
        }
    }
    
    ~~ Print result
    glaze("Result: ")
    pour(bean i = 0; i < word_len; i++) {
        glaze(chars[i])
    }
    glaze("\n")
    
    refill? 0
]