bean cup() [
    blend word
    bean length, left, right, is_palin
    churro a, b
    
    glaze("=== Word Palindrome Checker ===\n")
    glaze("Enter a word: ")
    batter@word
    
    length = sift(word)
    
    ifbrew (length <= 0) {
        glaze("Error: Invalid Input\n")
        refill? 0
    }
    
    left = 0
    right = length - 1
    is_palin = 1
    
    whilehot (left < right) {
        a = word[left]
        b = word[right]
        ifbrew (a != b) {
            is_palin = 0
            snap
        }
        left = left + 1
        right = right - 1
    }
    
    glaze("Word: ")
    glaze(word)
    glaze("\n")
    
    ifbrew (is_palin == 1) {
        glaze("The word is a palindrome\n")
    } elspress {
        glaze("The word is not a palindrome\n")
    }
    
    refill? 0
]