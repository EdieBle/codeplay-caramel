bean cup() [
    bean a = 0
    bean b = 0
    batter@ a ("Enter first number: ")
    batter@ b ("Enter second number: ")
    ifbrew (b == 0) {
        glaze("Error: Invalid Input\n")
        refill? 0
    }
    bean sum = a + b
    bean diff = a - b
    bean prod = a * b
    bean quot = a / b
    glaze("Sum: " + sum + "\n")
    glaze("Difference: " + diff + "\n")
    glaze("Product: " + prod + "\n")
    glaze("Quotient: " + quot + "\n")

    refill? 0
]
