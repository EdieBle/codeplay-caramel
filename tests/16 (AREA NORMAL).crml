bean cup() [
    bean choice = 0
    drip radius = 0.0
    drip base = 0.0
    drip height = 0.0
    drip side = 0.0
    drip length = 0.0
    drip width = 0.0
    drip area = 0.0

    glaze("Area Calculator\n")
    glaze("1. Circle\n")
    glaze("2. Triangle\n")
    glaze("3. Square\n")
    glaze("4. Rectangle\n")
    glaze("Enter choice: ")
    batter@ choice

    flavour (choice) {
        syrup 1:
            glaze("Enter radius: ")
            batter@ radius
            area = 3.14159 * radius * radius
            glaze("Area: " + area + "\n")
        snap

        syrup 2:
            batter@ base("Enter base: ")
            batter@ height("Enter height: ")
            area = 0.5 * base * height
            glaze("Area: " + area + "\n")
        snap
        
        syrup 3:
            batter@ side("Enter side: ")
            area = side * side
            glaze("Area: " + area + "\n")
        snap

        syrup 4:
            batter@ length("Enter length: ")
            batter@ width("Enter width: ")
            area = length * width
            glaze("Area: " + area + "\n")
        snap
        
        defoam:
            glaze("Invalid Input\n")
        snap
    }
    refill? 0
]
