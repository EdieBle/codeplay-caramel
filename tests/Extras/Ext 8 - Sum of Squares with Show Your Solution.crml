bean cup() [
    bean n = 0
    bean sum = 0
    glaze("Enter N: ")
    batter@ n
    ifbrew (n <= 0) {
        glaze("Error: Invalid Input\n")
        refill? 0
    }
    pour (bean i = 1; i <= n; i++) {
        bean sq = i * i
		glaze(i + "^2")
        sum = sum + sq
		ifbrew (i != n) {
			glaze(" + ")
		}
    }
    glaze("\nSum of squares from 1 to " + n + " = " + sum)
    refill? 0
]
