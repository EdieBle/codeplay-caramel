recipe drip circlearea(drip rad) [
    drip area = 3.14159 * rad * rad
    refill? (area)
]

recipe drip triarea(drip ba, drip he) [
    drip area = 0.5 * ba * he
    refill? (area)
]

recipe drip sqarea(drip si) [
    drip area = si * si
    refill? (area)
]

recipe drip rectarea(drip le, drip wi) [
    drip area = le * wi
    refill? (area)
]

bean cup() [
    bean choice = 0
    drip radius = 0.0
    drip base = 0.0
    drip height = 0.0
    drip side = 0.0
    drip length = 0.0
    drip width = 0.0
    drip result = 0.0

    glaze("Area Calculator\n")
    glaze("1. Circle\n")
    glaze("2. Triangle\n")
    glaze("3. Square\n")
    glaze("4. Rectangle\n")
    glaze("Enter choice: ")
    batter@ choice

    ifbrew (choice == 1) {
        batter@ radius("Enter radius: ")
        result = circlearea(radius)
        glaze("Area: " + result + "\n")
    }
    elifroth (choice == 2) {
        batter@ base("Enter base: ")
        batter@ height("Enter height: ")
        result = triarea(base, height)
        glaze("Area: " + result + "\n")
    }
    elifroth (choice == 3) {
        batter@ side("Enter side: ")
        result = sqarea(side)
        glaze("Area: " + result + "\n")
    }
    elifroth (choice == 4) {
        batter@ length("Enter length: ")
        batter@ width("Enter width: ")
        result = rectarea(length, width)
        glaze("Area: " + result + "\n")
    }
    elspress {
        glaze("Invalid Input\n")
    }
    refill? 0
]
