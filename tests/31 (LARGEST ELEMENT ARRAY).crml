bean arr[10]
recipe bean find_max(bean n, bean current_max) [
    ifbrew (n == 0) {
        refill? (current_max)
    }
    
    ifbrew (order.arr[n - 1] > current_max) {
        current_max = order.arr[n - 1]
    }
    
    refill? (find_max(n - 1, current_max))
]

bean cup() [
  bean n, max_val
  batter@n("How many elements (max 10)? ")
  glaze("Enter elements:\n")

  pour(bean i = 0; i < n; i++) {
      batter@order.arr[i]
  }

  max_val = find_max(n, order.arr[0])
  glaze("Largest element: " + max_val + "\n")
  refill? 0
]