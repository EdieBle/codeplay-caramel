bean cup() [
    bean n = 0
    bean num = 0
    bean count = 0
    glaze("Input a number: ")
    batter@ n
    ifbrew (n <= 0) {
        glaze("Error: Invalid Input\n")
        refill? 0
    }
    num = n
    whilehot (num > 0) {
        count = count + 1
        bean rem = num % 10
        bean even = num - rem
        num = even / 10
    }
    ifbrew (count == 0) {
        count = 1
    }
    glaze("The number of digits in the number is: ")
    glaze(count)
    glaze("\n")
    refill? 0
]
