recipe bean count_dig(bean num) [
    ifbrew (num == 0) {
        refill? (0)
    }
    bean rem = num % 10
    bean rest = num - rem
    refill? (count_dig(rest / 10) + 1)
]

bean cup() [
    bean n = 0
    bean count = 0
    glaze("Input a number: ")
    batter@ n
    ifbrew (n <= 0) {
        glaze("Error: Invalid Input\n")
        refill? 0
    }
    count = count_dig(n)
    glaze("The number of digits in the number is: ")
    glaze(count)
    glaze("\n")
    refill? 0
]