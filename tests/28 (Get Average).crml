bean cup() [
	drip math[5]=[0,0,0,0,0]
	drip sci[5]=[0,0,0,0,0]
	drip eng[5]=[0,0,0,0,0]
	drip fil[5]=[0,0,0,0,0]

	drip score = 0
	drip sum, sum_math, sum_sci, sum_eng, sum_fil
	drip average_math, average_sci, average_eng, average_fil
	glaze("===Math Quiz Scores===\n")
	pour(bean i=1; i<6; i++){
		glaze("Quiz " + i+1 + ": ")
		batter@ score
		math[i] = score
		sum_math = sum_math + score
	}
	
	average_math = sum_math/5
	glaze("[MATH] AVERAGE: " + average_math)
	
	glaze("\n===Science Quiz Scores===\n")
	pour(bean i=1; i<6; i++){
		glaze("Quiz " + i+1 + ": ")
		batter@ score
		sci[i] = score
		sum_sci = sum_sci + score
	}
	
	average_sci = sum_sci/5
	glaze("[SCIENCE] AVERAGE: " + average_sci)
	
	glaze("\n===English Quiz Scores===\n")
	pour(bean i=1; i<6; i++){
		glaze("Quiz " + i+1 + ": ")
		batter@ score
		eng[i] = score
		sum_eng = sum_eng + score
	}

	average_eng = sum_eng/5
	glaze("[ENGLISH] AVERAGE: " + average_eng)

	glaze("\n===Filipino Quiz Scores===\n")
	pour(bean i=1; i<6; i++){
		glaze("Quiz " + i+1 + ": ")
		batter@ score
		fil[i] = score
		sum_fil = sum_fil + score
	}
	average_fil = sum_fil/5
	glaze("[FILIPINO] AVERAGE: " + average_fil)
	
  refill? 0
]