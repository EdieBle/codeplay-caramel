recipe temp is_prime(bean n) [
    ifbrew (n <= 1) {
        refill? (cold)
    }
    pour(bean i = 2; i < n; i++) {
        ifbrew (n % i == 0) {
            refill? (cold)
        }
    }
    refill? (hot)
]

bean cup() [
    bean n, n1

    glaze("Input start number: ")
    batter@n

    glaze("Input end number: ")
    batter@n1
    ifbrew (n < 2) {
        glaze("Error: number must be at least 2\n")
        refill? 0
    }

    glaze("Prime numbers from 1 to " + n + " : ")
	~~ Calculate the prime numbers ranging from 1 to N
    pour(bean i = n; i <= n1; i++) {
        ifbrew (is_prime(i)) {
            glaze(i)
            glaze(" ")
        }
    }
    glaze("\n")
    refill? 0
]