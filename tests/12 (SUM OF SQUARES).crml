bean cup() [
    bean n = 0
    bean sum = 0
    batter@ n ("Enter N: ")
    ifbrew (n <= 0) {
        glaze("Error: Invalid Input\n")
        refill? 0
    }
    pour (bean i = 1; i <= n; i++) {
        bean sq = i * i
        sum = sum + sq
    }
    glaze("Sum of squares from 1 to " + n + ": " + sum + "\n")
    refill? 0
]
