bean cup() [
    bean n = 0
    bean num = 0
    bean rev = 0
    bean sumdig = 0
    bean digit = 0
    bean even = 0
    bean prod = 0
	temp is_neg = cold
    glaze("Enter a number: ")
    batter@ n
    ifbrew (n <= 0) {
        n *= -1
		    is_neg = hot
    }
    num = n
    whilehot (num > 0) {
        digit = num % 10
        prod = rev * 10
        rev = prod + digit
        sumdig = sumdig + digit
        even = num - digit
        num = even / 10
    }
	
	ifbrew (is_neg == hot) {
		rev *= -1
		sumdig *= -1
	}

    glaze("Sum of digits: " + sumdig + "\n")
    glaze("Reverse: " + rev + "\n")
    refill? 0
]
