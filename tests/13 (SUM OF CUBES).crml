bean cup() [
    bean n = 0
    bean sum = 0
    batter@ n("Enter N: ")
    ifbrew (n <= 0) {
        glaze("Error: Invalid Input\n")
        refill? 0
    }
    pour (bean i = 1; i <= n; i++) {
        bean cu = i * i
        bean cb = cu * i
        sum = sum + cb
    }
    glaze("Sum of cubes from 1 to " + n + ": " + sum + "\n")
    refill? 0
]
