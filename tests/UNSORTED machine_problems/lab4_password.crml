bean cup() [
    bean pin = 0
    bean valid = 0
    bean tmp = 0
    bean digit = 0
    bean digits = 0
    bean haseven = 0
    bean hasodd = 0
    bean rem = 0
    bean even = 0
    glaze("=== PIN Validator ===\n")
    glaze("Rules: 4-8 digits, must have even and odd digits\n")
    whilehot (valid == 0) {
        glaze("Enter PIN: ")
        batter@ pin
        ifbrew (pin <= 0) {
            glaze("Error: Invalid Input\n")
            refill? 0
        }
        digits = 0
        haseven = 0
        hasodd = 0
        tmp = pin
        whilehot (tmp > 0) {
            digit = tmp % 10
            rem = digit % 2
            ifbrew (rem == 0) {
                haseven = 1
            }
            ifbrew (rem == 1) {
                hasodd = 1
            }
            digits = digits + 1
            even = tmp - digit
            tmp = even / 10
        }
        ifbrew (digits < 4) {
            glaze("Too short! Need at least 4 digits.\n")
        }
        ifbrew (digits > 8) {
            glaze("Too long! Maximum 8 digits.\n")
        }
        ifbrew (digits >= 4) {
            ifbrew (digits <= 8) {
                ifbrew (haseven == 0) {
                    glaze("Must contain at least one even digit.\n")
                }
                ifbrew (hasodd == 0) {
                    glaze("Must contain at least one odd digit.\n")
                }
                ifbrew (haseven == 1) {
                    ifbrew (hasodd == 1) {
                        valid = 1
                    }
                }
            }
        }
    }
    glaze("PIN accepted: ")
    glaze(pin)
    glaze("\n")
    refill? 0
]
