bean cup() [
  bean cl_num, sel_cl, t_count, t_done, exited, choice, valid
  bean d_day, d_month, d_year, d_midx
  bean cl_accnum[***]
  drip balance[***]
  bean cl_tdone[***]
  drip cl_dep[***]
  drip cl_wdr[***]
  bean t_type[***]
  drip t_amt[***]
  bean t_day[***]
  bean t_month[***]
  bean t_year[***]
  bean dim[***]
  blend cl_name[***]
  churro cont

  dim[0] = 31
  dim[1] = 28
  dim[2] = 31
  dim[3] = 30
  dim[4] = 31
  dim[5] = 30
  dim[6] = 31
  dim[7] = 31
  dim[8] = 30
  dim[9] = 31
  dim[10] = 30
  dim[11] = 31

  glaze("================================================\n")
  glaze("\tBANKING TRANSACTION SYSTEM\n")
  glaze("================================================\n")
  glaze("\tTRANSACTION DATE\n")
  glaze("------------------------------------------------\n")
  batter@ d_month("\tEnter Month (1-12): ")
  batter@ d_day("\tEnter Day   (DD): ")
  batter@ d_year("\tEnter Year  (YY): ")
  glaze("------------------------------------------------\n")
  batter@ cl_num("\tEnter number of clients (max 5): ")
  ifbrew(cl_num > 5) {
    glaze("\tMaximum is 5. Setting to 5.\n")
    cl_num = 5
  }

  pour(bean i = 0; i < cl_num; i++) {
    glaze("------------------------------------------------\n")
    glaze("\tClient " + (i + 1) + "\n")
    batter@ cl_name[i]("\tName      : ")
    batter@ cl_accnum[i]("\tACC NO.   : ")
    balance[i] = 0
    cl_tdone[i] = 0
    cl_dep[i] = 0
    cl_wdr[i] = 0
  }

  cont = 'Y'
  whilehot(cont == 'Y' || cont == 'y') {

    glaze("\n================================================\n")
    glaze("\tSELECT CLIENT\n")
    glaze("\tDate: " + d_month + "-" + d_day + "-" + d_year + "\n")
    glaze("================================================\n")
    pour(bean i = 0; i < cl_num; i++) {
      glaze("\t[" + (i+1) + "] " + cl_name[i] + " | ACC: " + cl_accnum[i] + " | Bal: " + balance[i] + " | Trxn: " + cl_tdone[i] + "/5\n")
    }
    glaze("------------------------------------------------\n")
    glaze("\tSelect client (1 to ")
    glaze(cl_num)
    glaze("): ")
    batter@ sel_cl
    sel_cl = sel_cl - 1

    ifbrew(sel_cl < 0 || sel_cl >= cl_num) {
      glaze("\t[!] Invalid client selection.\n")
      cont = 'N'
    } elifroth(cl_tdone[sel_cl] >= 5) {
      glaze("\n\t[!] Client has reached max transactions for today.\n")
      glaze("\tPlease select another client.\n")
      batter@ cont("\tTransact with another client? [ Y / N ]: ")
      ifbrew(cont == 'N' || cont == 'n') {
        glaze("\tEnding banking day...\n")
        d_day = d_day + 1
        d_midx = d_month - 1
        ifbrew(d_day > dim[d_midx]) {
          d_day = 1
          d_month = d_month + 1
          ifbrew(d_month > 12) {
            d_month = 1
            d_year = d_year + 1
          }
        }
        pour(bean i = 0; i < cl_num; i++) {
          cl_tdone[i] = 0
          cl_dep[i] = 0
          cl_wdr[i] = 0
        }
        glaze("\tNew Date: " + d_month + "-" + d_day + "-" + d_year + "\n")
        glaze("\tAll client counters reset for new day.\n")
        cont = 'Y'
      }
    } elspress {
      t_count = 0
      t_done = cl_tdone[sel_cl]
      exited = 0

      whilehot(t_done < 5 && exited == 0) {
        glaze("\n================================================\n")
        glaze("\tBANKING TRANSACTION\n")
        glaze("================================================\n")
        glaze("\tClient  : " + cl_name[sel_cl] + "\n")
        glaze("\tACC NO. : " + cl_accnum[sel_cl] + "\n")
        glaze("\tDate    : " + d_month + "-" + d_day + "-" + d_year + "\n")
        glaze("\tTrxn    : " + t_done + " / 5\n")
        glaze("================================================\n")
        glaze("\t[1] DEPOSIT\n")
        glaze("\t[2] WITHDRAW\n")
        glaze("\t[3] BALANCE INQUIRY\n")
        glaze("\t[4] DISPLAY TRANSACTION SUMMARY\n")
        glaze("\t[5] EXIT\n")
        glaze("------------------------------------------------\n")
        batter@ choice("\tEnter choice: ")
        valid = 0

        flavour(choice) {
          syrup 1:
            glaze("------------------------------------------------\n")
            batter@ t_amt[t_count]("\tDeposit amount (max 50,000): ")
            ifbrew(t_amt[t_count] <= 0) {
              glaze("\t[!] Amount must be greater than 0.\n")
            } elifroth(t_amt[t_count] > 50000) {
              glaze("\t[!] Exceeds maximum deposit of 50,000.\n")
            } elifroth(cl_dep[sel_cl] + t_amt[t_count] > 50000) {
              glaze("\t[!] Exceeds daily deposit limit of 50,000.\n")
            } elspress {
              balance[sel_cl] = balance[sel_cl] + t_amt[t_count]
              cl_dep[sel_cl] = cl_dep[sel_cl] + t_amt[t_count]
              t_type[t_count] = 1
              t_day[t_count] = d_day
              t_month[t_count] = d_month
              t_year[t_count] = d_year
              t_count = t_count + 1
              t_done = t_done + 1
              cl_tdone[sel_cl] = t_done
              valid = 1
              glaze("\t[OK] Deposit successful!\n")
              glaze("\tNew Balance: " + balance[sel_cl] + "\n")
            }
          snap

          syrup 2:
            glaze("------------------------------------------------\n")
            batter@ t_amt[t_count]("\tWithdrawal amount (max 20,000): ")
            ifbrew(t_amt[t_count] <= 0) {
              glaze("\t[!] Amount must be greater than 0.\n")
            } elifroth(t_amt[t_count] > 20000) {
              glaze("\t[!] Exceeds maximum withdrawal of 20,000.\n")
            } elifroth(cl_wdr[sel_cl] + t_amt[t_count] > 20000) {
              glaze("\t[!] Exceeds daily withdrawal limit of 20,000.\n")
            } elifroth(t_amt[t_count] > balance[sel_cl]) {
              glaze("\t[!] Insufficient balance.\n")
            } elspress {
              balance[sel_cl] = balance[sel_cl] - t_amt[t_count]
              cl_wdr[sel_cl] = cl_wdr[sel_cl] + t_amt[t_count]
              t_type[t_count] = 2
              t_day[t_count] = d_day
              t_month[t_count] = d_month
              t_year[t_count] = d_year
              t_count = t_count + 1
              t_done = t_done + 1
              cl_tdone[sel_cl] = t_done
              valid = 1
              glaze("\t[OK] Withdrawal successful!\n")
              glaze("\tNew Balance: " + balance[sel_cl] + "\n")
            }
          snap

          syrup 3:
            glaze("------------------------------------------------\n")
            glaze("\tCurrent Balance: " + balance[sel_cl] + "\n")
            glaze("------------------------------------------------\n")
          snap

          syrup 4:
            glaze("\n================================================\n")
            glaze("\tTRANSACTION SUMMARY\n")
            glaze("================================================\n")
            glaze("\tClient  : " + cl_name[sel_cl] + "\n")
            glaze("\tACC NO. : " + cl_accnum[sel_cl] + "\n")
            glaze("------------------------------------------------\n")
            pour(bean j = 0; j < t_count; j++) {
              glaze("\tTrxn " + (j+1) + " | ")
              glaze(t_month[j] + "-" + t_day[j] + "-" + t_year[j] + " | ")
              ifbrew(t_type[j] == 1) {
                glaze("DEPOSIT  | ")
              } elspress {
                glaze("WITHDRAW | ")
              }
              glaze("Amount: " + t_amt[j] + "\n")
            }
            glaze("================================================\n")
          snap

          syrup 5:
            exited = 1
          snap

          defoam:
            glaze("\t[!] Invalid Input.\n")
          snap
        }

        ifbrew(valid == 1 && t_done < 5) {
          batter@ cont("\tAnother transaction? [ Y / N ]: ")
          ifbrew(cont == 'N' || cont == 'n') {
            exited = 1
          }
        }
      }

      ifbrew(t_done >= 5 && exited == 0) {
        glaze("\n\t[!] Max transactions reached for today.\n")
        glaze("\tPlease select another client.\n")
        batter@ cont("\tTransact with another client? [ Y / N ]: ")
        ifbrew(cont == 'N' || cont == 'n') {
          glaze("\tEnding banking day...\n")
          d_day = d_day + 1
          d_midx = d_month - 1
          ifbrew(d_day > dim[d_midx]) {
            d_day = 1
            d_month = d_month + 1
            ifbrew(d_month > 12) {
              d_month = 1
              d_year = d_year + 1
            }
          }
          pour(bean i = 0; i < cl_num; i++) {
            cl_tdone[i] = 0
            cl_dep[i] = 0
            cl_wdr[i] = 0
          }
          cont = 'Y'
          glaze("\tNew Date: " + d_month + "-" + d_day + "-" + d_year + "\n")
          glaze("\tAll client counters reset for new day.\n")
          
        }
      }

      ifbrew(exited == 1) {
        batter@ cont("\tTransact with another client? [ Y / N ]: ")
      }
    }
  }

  glaze("\n================================================\n")
  glaze("\tBANKING TRANSACTION ENDED\n")
  glaze("\tThank you for transacting with us!\n")
  glaze("================================================\n")
  refill? 0
]